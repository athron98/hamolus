---
/**
 * Base layout.
 *
 * Just the document skeleton: `<head>`, a skip link, and the slot. Astro has no shared
 * components across projects by default, so a layout this small gets rewritten more often
 * than it gets read — and that is fine.
 */
interface LocaleDefinition {
  code: string
  label?: string
}

interface Props {
  title: string
  description?: string
  /** Language code for the `lang` attribute. Leave it out on a single-language site. */
  lang?: string
  /**
   * The language list for the menu. Passed down from the page, which already fetched it
   * from the core through `effectiveLocales()` — the layout does not call the core itself,
   * so the same data is never fetched twice.
   *
   * When a page sends nothing, the menu falls back to the single language from `lang`. That
   * is the single-language case; a multilingual site must always pass this list.
   */
  locales?: LocaleDefinition[]
}

const { title, description, lang = 'id', locales } = Astro.props

/**
 * Menu labels for the language switcher.
 *
 * In order: the `label` from the core, then this short map, then the bare code. The code
 * always shows up as text, so a menu entry is never blank.
 */
const LANGUAGE_LABELS: Record<string, string> = {
  en: 'English',
  id: 'Bahasa Indonesia',
  'pt-BR': 'Português (Brasil)',
}

const menuLocales = locales?.length ? locales : [{ code: lang }]

/** A readable language name, with the code as the safety net. */
const languageLabel = (code: string) => LANGUAGE_LABELS[code] ?? code

/**
 * A path that starts with `/` and ends with `/`.
 *
 * The trailing slash is required because `directory` output plus `trailingSlash: 'always'`
 * builds `id/about/index.html` for `id/about/`. Without it, a link can end in a 404 on a
 * static host, and the `Astro.url.pathname` used for the canonical URL will not match the
 * path written here.
 */
const localePath = (code: string, page = ''): string =>
  page ? `/${code}/${page}/` : `/${code}/`

/**
 * The canonical URL uses `Astro.site` when there is one, and the request URL as-is when
 * there is not. `Astro.url` always exists, so `astro dev` without a `site` config stays
 * safe.
 */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <!--
      `Astro.site` only exists when `site` is set in astro.config. Without the guard,
      `astro check` fails because its type is `URL | undefined`, and a page opened through
      `astro dev` without `site` blows up too.
    -->
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <a class="brand" href={localePath(lang)}>Hamolus Corp</a>
      <nav aria-label="Main">
        <a href={localePath(lang)}>Home</a>
        <a href={localePath(lang, 'about')}>About</a>
        {
          menuLocales
            .filter((entry) => entry.code !== lang)
            .map((entry) => (
              <a href={localePath(entry.code)} lang={entry.code} hreflang={entry.code}>
                {entry.label ?? languageLabel(entry.code)}
              </a>
            ))
        }
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>Astro corporate site example for Hamolus. Content is read from the core at build time.</p>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
    --ink: #16181d;
    --muted: #5f6672;
    --line: #e2e5ea;
    --accent: #2f5cff;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  body {
    margin: 0 auto;
    max-width: 720px;
    padding: 0 20px 72px;
    color: var(--ink);
    line-height: 1.65;
  }

  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: 8px;
    top: 8px;
    background: var(--accent);
    color: #fff;
    padding: 8px 12px;
    z-index: 1;
  }

  header {
    align-items: baseline;
    border-bottom: 1px solid var(--line);
    display: flex;
    gap: 20px;
    justify-content: space-between;
    padding: 24px 0;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
    color: inherit;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  h1 {
    font-size: 1.6rem;
    line-height: 1.25;
  }

  .meta {
    color: var(--muted);
    font-size: 0.9rem;
  }

  article {
    border-bottom: 1px solid var(--line);
    padding: 20px 0;
  }

  article:last-child {
    border-bottom: 0;
  }

  article h2 {
    font-size: 1.15rem;
    margin: 0 0 6px;
  }

  article h2 a {
    color: inherit;
    text-decoration: none;
  }

  article h2 a:hover {
    color: var(--accent);
  }

  .excerpt {
    margin: 0 0 8px;
  }

  .tag {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-radius: 999px;
    display: inline-block;
    font-size: 0.75rem;
    margin-right: 6px;
    padding: 2px 8px;
  }

  .prose :is(h2, h3) {
    margin-top: 1.8em;
  }

  .prose pre {
    background: #10131a;
    border-radius: 8px;
    color: #e8ecf3;
    overflow-x: auto;
    padding: 14px 16px;
  }

  footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
    margin-top: 48px;
    padding-top: 16px;
  }
</style>
