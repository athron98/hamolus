# Copy to `.env` and fill it in. Do not commit `.env`.
#
# The `PUBLIC_` prefix means the value is inlined into the browser bundle. That is what you
# want for a public core URL; for anything secret, do not use this prefix.

# Core URL, without a trailing `/api` — `apiBase()` below is what appends it.
PUBLIC_HAMOLUS_ORIGIN=http://localhost:8787

# Fallback locale for when the core has no localization configured at all. If the core does
# have a language list, that list wins — not this value.
PUBLIC_HAMOLUS_LOCALE=en
