# Copy to `.env.local` and fill in. NEVER commit `.env.local`.

# Core base URL. `/api` is added automatically by normalizeApiBase.
VITE_PANEL_API_URL=http://localhost:8787

# Panel token. Required: PanelClient throws a PanelError when it is empty.
VITE_PANEL_API_TOKEN=

# Optional scope. If set it must match the scope of the token's account, otherwise the core
# answers SCOPE_MISMATCH.
VITE_PANEL_LAND=
VITE_PANEL_COLONY=

# First view. Optional — if empty or unknown, the panel uses the first menu entry.
VITE_PANEL_DEFAULT_VIEW=agenda

# Locale for the first request. The real list of languages still belongs to the core and is
# read from GET /_meta/localization, so adding a language is a core-side change.
VITE_PANEL_LOCALE=id
