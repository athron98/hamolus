# Copy to `.env.local` and fill in. NEVER commit `.env.local`.

# Core base URL. `/api` is added automatically by normalizeApiBase, so writing it without
# `/api` is fine too — `https://api.example.com` and `https://api.example.com/api` produce
# the same base.
VITE_PANEL_API_URL=http://localhost:8787

# Panel token. Required: PanelClient throws a PanelError when it is empty.
# Get one via `POST /api/_auth/login`, or create a panel key in the console.
VITE_PANEL_API_TOKEN=

# Optional scope. If set it must match the scope of the token's account, otherwise the core
# answers SCOPE_MISMATCH.
VITE_PANEL_LAND=
VITE_PANEL_COLONY=

# View opened first. Optional — if empty or absent from the manifest, the panel uses the
# first menu entry.
VITE_PANEL_DEFAULT_VIEW=overview

# Locale for the first request. The real list of languages still belongs to the core and is
# read from GET /_meta/localization.
VITE_PANEL_LOCALE=id
