# Copy to `.env.local` and fill it in. Do not commit `.env.local`.
#
# The `NEXT_PUBLIC_` prefix means the value is inlined into the browser bundle. That is
# what you want for a public core URL; for anything secret, do not use this prefix.
#
# These values are read on the server (Server Components, Route Handlers, generateMetadata),
# so `localhost` here means localhost on the machine running Next — not on the reader's
# browser.

# Core URL, without a trailing `/api` — `apiBase()` below is what appends it.
HAMOLUS_API_ORIGIN={{CORE_ORIGIN}}

# Locale for the request.
HAMOLUS_LOCALE=id

# How many seconds the Next cache may reuse a core response before fetching it again.
HAMOLUS_REVALIDATE_SECONDS=60

# Token for `POST /api/revalidate`. No `NEXT_PUBLIC_` prefix, so it is not inlined into the
# browser bundle. Leave it empty if there is no webhook; the endpoint replies 503.
HAMOLUS_REVALIDATE_TOKEN=replace-with-a-long-random-string
