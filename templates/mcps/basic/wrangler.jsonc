{
  // Worker name + entry point
  //
  // `main` points at the local seam in src/index.ts, which re-exports the server from
  // @hamolus/mcp. Edit that file to wrap it; you never need to fork the package.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "{{PROJECT_SLUG}}-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // The MCP server binds no D1/KV/R2: it is a stateless proxy that turns the core API
  // into MCP tools, so it has nothing to store and nothing to migrate.
  //
  // TWO VARS IS THE WHOLE SETUP. Everything else — which land/colony this server may
  // touch, whether it may write, which tool groups it offers, and who may call it —
  // lives in the core and is changed from the console, with no redeploy.
  "vars": {
    // Base URL of the core API (must end with /api). Point it at your deployed core:
    //   local  -> http://localhost:8787/api
    //   online -> https://{{PROJECT_SLUG}}-core.<your-account>.workers.dev/api
    "CORE_API_URL": "http://localhost:8787/api",

    // This server's id in the core. Create the instance in the console
    // (Environment -> MCP), then paste the id here.
    //
    // It is a credential, not a label: anyone holding it can read this server's
    // configuration, and it is generated for you precisely so it cannot be guessed.
    "MCP_INSTANCE_ID": ""
  }

  // There are no secrets to set.
  //
  // The old arrangement wanted `wrangler secret put CORE_ADMIN_KEY` — a platform-wide
  // admin key that could reach every land and colony, where "read only" was a promise
  // the worker made rather than a rule the core enforced. A console-managed instance
  // gets its permissions from the core instead, and callers present a per-user token
  // that the console issued and can revoke.
  //
  // Migrating: set MCP_INSTANCE_ID, deploy, and drop the CORE_ADMIN_KEY /
  // MCP_BEARER_TOKEN secrets. Until MCP_INSTANCE_ID is set, the deprecated env path
  // still works — `GET /` on this worker will say `mode: "legacy"` and warn you.

  // REACHING THE CORE FROM AN ONLINE DEPLOYMENT
  // -------------------------------------------
  // `CORE_API_URL` above is all you need on most accounts. On some accounts that
  // address is not reachable from inside the Workers runtime: the request comes back
  // as a bodyless `404` from the edge, for any path, including this worker's own
  // hostname — so the URL is never wrong and editing it never helps. A service
  // binding dispatches straight to the core worker in the same account instead.
  //
  // Commented out because it is not universally needed and it is not compatible with
  // `pnpm dev`, where it would take precedence over the URL and try to reach the local
  // core as a service instead of over `http://localhost:8787`. Enable it when you
  // deploy online, with the name of your core worker:
  //
  //   "services": [{ "binding": "CORE", "service": "{{PROJECT_SLUG}}-core" }]
  //
  // The core routes on path and never reads `Host`, so the bound call reuses the URL
  // that was already built and only the destination changes.
}
