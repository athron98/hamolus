# Dev port for this server only. `pnpm dev` reads it, so `HAMOLUS_MCP_PORT=8798 pnpm dev`
# runs a second checkout on one machine. Deploys have no port at all — a deployed Worker
# is addressed by its URL, so this is a `wrangler dev` setting and nothing more.
# HAMOLUS_MCP_PORT=8788

# Core the MCP server talks to
#
# The server is a separate deployment, so it points at your *deployed* core,
# not at localhost. Wrangler loads this file automatically in `wrangler dev`.
CORE_API_URL=https://{{PROJECT_SLUG}}-core.<your-account>.workers.dev/api

# This server's id in the core, created in the console (Environment -> MCP).
#
# With this set, everything else is read from the core at request time: the
# land/colony, the read-only switch, the tool groups, and which tokens are
# accepted. Change any of those in the console and this server picks it up within
# a minute — no redeploy.
MCP_INSTANCE_ID=

# Callers authenticate with a per-user token from the console, sent as
# `Authorization: Bearer <token>`. There is nothing to configure here: the
# console issues tokens, this server exchanges each one for a short-lived
# session, and revoking a token in the console takes effect within 15 minutes.
