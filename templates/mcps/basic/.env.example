# Dev port for this server only. `pnpm dev` reads it, so `HAMOLUS_MCP_PORT=8798 pnpm dev`
# runs a second checkout on one machine. Deploys have no port at all — a deployed Worker
# is addressed by its URL, so this is a `wrangler dev` setting and nothing more.
# HAMOLUS_MCP_PORT=8788

# Core the MCP server talks to
#
# The server is a separate deployment, so it points at your *deployed* core,
# not at localhost. Wrangler loads this file automatically in `wrangler dev`;
# for a deployed Worker use `wrangler secret put` instead of shipping a file.
CORE_API_URL=https://{{PROJECT_SLUG}}-core.<your-account>.workers.dev/api

# Auth for the core. Prefer a scoped user token over the admin key:
#   CORE_API_TOKEN   a JWT from POST /api/_auth/token
#   CORE_ADMIN_KEY   admin key, used to mint a JWT at startup when no token is set
CORE_API_TOKEN=
CORE_ADMIN_KEY=

# Optional land / colony scoping (sent as x-land / x-colony on every request).
# Leave CORE_LAND empty for the default land of a single-tenant core.
CORE_LAND=
CORE_COLONY=

# Require this bearer token on POST /mcp. Strongly recommended once public:
# anyone who knows the URL can otherwise call every tool your token allows.
MCP_BEARER_TOKEN=

# "true" refuses every write tool (read-only agent).
MCP_READONLY=false
